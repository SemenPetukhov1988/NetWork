<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/authFragment">

    <!-- Экран авторизации -->
    <fragment
        android:id="@+id/authFragment"
        android:name="ru.netology.network.fragment.AuthFragment"
        android:label="Авторизация">

        <action
            android:id="@+id/action_authFragment_to_registrationFragment"
            app:destination="@id/registrationFragment" />
    </fragment>

    <!-- Экран регистрации -->
    <fragment
        android:id="@+id/registrationFragment"
        android:name="ru.netology.network.fragment.RegistrationFragment"
        android:label="Регистрация" />

    <!-- Экран стены (ленты) -->
    <fragment
        android:id="@+id/myWallFragment"
        android:name="ru.netology.network.fragment.MyWallFragment"
        android:label="Лента">

        <!-- ПРОСТОЙ ЭКШЕН: переход на экран входа -->
        <action
            android:id="@+id/action_myWallFragment_to_authFragment"
            app:destination="@id/authFragment" />
    </fragment>

    <!-- ГЛОБАЛЬНЫЙ ПЕРЕХОД НА СТЕНУ (для автовхода из MainActivity) -->
    <action
        android:id="@+id/action_global_to_wall"
        app:destination="@id/myWallFragment"
        app:popUpTo="@id/authFragment"
        app:popUpToInclusive="true" />
</navigation>