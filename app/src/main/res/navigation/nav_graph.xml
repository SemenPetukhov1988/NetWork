<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/authFragment">

    <!-- 1. Экран авторизации -->
    <fragment
        android:id="@+id/authFragment"
        android:name="ru.netology.network.fragment.AuthFragment"
        android:label="Авторизация">

        <action
            android:id="@+id/action_authFragment_to_registrationFragment"
            app:destination="@id/registrationFragment" />
    </fragment>

    <!-- 2. Экран регистрации -->
    <fragment
        android:id="@+id/registrationFragment"
        android:name="ru.netology.network.fragment.RegistrationFragment"
        android:label="Регистрация" />

    <!-- 3. ГЛАВНЫЙ ЭКРАН С ВКЛАДКАМИ (MainTabsFragment) -->
    <!-- Теперь это единый контейнер для Ленты, Событий и Пользователей -->
    <fragment
        android:id="@+id/feedFragment"
        android:name="ru.netology.network.fragment.MainTabsFragment"
        android:label="Главная">

        <!-- Переход на экран входа (если пользователь разлогинился) -->
        <action
            android:id="@+id/action_feedFragment_to_authFragment"
            app:destination="@id/authFragment"
            app:popUpTo="@id/feedFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- ГЛОБАЛЬНЫЙ ПЕРЕХОД НА ГЛАВНЫЙ ЭКРАН -->
    <!-- Используется в MainActivity после успешного входа -->
    <action
        android:id="@+id/action_global_to_feed"
        app:destination="@id/feedFragment"
        app:popUpTo="@id/authFragment"
        app:popUpToInclusive="true" />
    <fragment
        android:id="@+id/profileFragment"
        android:name="ru.netology.network.fragment.ProfileFragment"
        android:label="ProfileFragment" >
        <action
            android:id="@+id/action_profileFragment_to_authFragment"
            app:destination="@id/authFragment" />
    </fragment>

</navigation>