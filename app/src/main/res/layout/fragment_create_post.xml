<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Заголовок -->
    <TextView
        android:id="@+id/tvNewPostTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:layout_marginTop="16dp"
        android:text="New post"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Кнопка «Назад» -->
    <ImageView
        android:id="@+id/ivBackArrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/back"
        android:contentDescription="Назад"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Кнопка «Опубликовать» -->
    <ImageView
        android:id="@+id/ivCheckMark"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/check_24dp_000000_fill0_wght400_grad0_opsz24"
        android:contentDescription="Опубликовать"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Поле ввода текста -->
    <!-- ВАЖНО: Теперь его низ привязан к РАЗДЕЛИТЕЛЮ, а не к картинке -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPostText"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvNewPostTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/dividerLine">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPostText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Напишите что-нибудь..."
            android:minLines="4"
            android:gravity="top"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingVertical="16dp"
            android:background="@android:color/transparent" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Место под картинку -->
    <!-- ВАЖНО: Картинка теперь "плавающая". Она привязана сверху к тексту, снизу к линии.
         Если её нет (visibility gone или пустая), она схлопывается в 0 и не мешает. -->
    <ImageView
        android:id="@+id/ivPostImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:contentDescription="Изображение поста"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/tilPostText"
        app:layout_constraintBottom_toTopOf="@id/dividerLine"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:visibility="gone" />
    <!-- visibility="gone" ставим по умолчанию, чтобы сразу видеть эффект.
         В коде (Kotlin/Java) ты будешь менять это на VISIBLE, когда загрузишь фото -->

    <!-- Разделительная линия -->
    <View
        android:id="@+id/dividerLine"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/ivPostImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Кнопка Remove (скрыта) -->
    <Button
        android:id="@+id/btnRemoveImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Remove"
        android:textSize="12sp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/ivPostImage"
        app:layout_constraintEnd_toEndOf="@id/ivPostImage" />

    <!-- Панель кнопок внизу -->
    <LinearLayout
        android:id="@+id/bottomActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dividerLine">

        <ImageButton
            android:id="@+id/btnCamera"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/add_a_photo_24dp_000000_fill0_wght400_grad0_opsz24"
            android:contentDescription="Камера"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/btnTagUsers"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/groups_24dp_000000_fill0_wght400_grad0_opsz24"
            android:contentDescription="Отметить пользователей"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/btnLocation"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/add_location_24dp_000000_fill0_wght400_grad0_opsz24"
            android:contentDescription="Геолокация"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
