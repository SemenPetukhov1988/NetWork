<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ================= ШАПКА (НЕ СКРОЛЛИТСЯ) ================= -->
    <TextView
        android:id="@+id/tvNewPostTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:layout_marginTop="16dp"
        android:text="New post"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/ivBackArrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/back"
        android:contentDescription="Назад"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- УБРАЛИ прогресс-бар отсюда. Он теперь в overlay -->
    <ImageView
        android:id="@+id/ivCheckMark"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/check_24dp_000000_fill0_wght400_grad0_opsz24"
        android:contentDescription="Опубликовать"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ================= СКРОЛЛИМАЯ ОБЛАСТЬ (Контент) ================= -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/tvNewPostTitle"
        app:layout_constraintBottom_toTopOf="@id/bottomActions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Поле ввода текста -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPostText"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPostText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Напишите что-нибудь..."
                    android:minLines="4"
                    android:gravity="top"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingVertical="16dp"
                    android:background="@android:color/transparent" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Блок ошибки и кнопка «Повторить» -->
            <LinearLayout
                android:id="@+id/errorBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:visibility="gone"
                android:background="#FFF3E0"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#D84315"
                    android:textSize="14sp"
                    android:text="Не удалось загрузить пост" />

                <Button
                    android:id="@+id/btnRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Повторить"
                    style="?attr/borderlessButtonStyle"
                    android:textColor="?attr/colorPrimary" />
            </LinearLayout>

            <!-- Место под картинку -->
            <ImageView
                android:id="@+id/ivPostImage"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:scaleType="centerCrop"
                android:contentDescription="Изображение поста"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <!-- Кнопка "Удалить фото" -->
            <Button
                android:id="@+id/btnRemoveImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Удалить фото"
                android:textSize="12sp"
                android:background="@android:color/transparent"
                android:textColor="?attr/colorPrimary"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <!-- Разделительная линия -->
            <View
                android:id="@+id/dividerLine"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ================= КНОПКИ ВНИЗУ (НЕПОДВИЖНЫЕ) ================= -->
    <LinearLayout
        android:id="@+id/bottomActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnCamera"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/add_a_photo_24dp_000000_fill0_wght400_grad0_opsz24"
            android:contentDescription="Камера"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/btnTagUsers"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/groups_24dp_000000_fill0_wght400_grad0_opsz24"
            android:contentDescription="Отметить пользователей"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/btnLocation"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/add_location_24dp_000000_fill0_wght400_grad0_opsz24"
            android:contentDescription="Геолокация"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- ================= СЛОЙ ЗАГРУЗКИ (ПОВЕРХ ВСЕГО) ================= -->
    <!-- Этот блок будет перекрывать весь экран, когда идёт загрузка -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#CCFFFFFF"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <!-- Контейнер для центрирования текста и прогресс-бара вместе -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_gravity="center">

        <ProgressBar
            android:id="@+id/progressBar"
            style="?attr/progressBarStyle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:indeterminateTint="#666666"
        android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvLoadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Идёт загрузка поста…"
            android:textColor="#666666"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="2sp" />
    </LinearLayout>
</FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
